{
  "description": "会话启动时把用户全局约束全文注入上下文；用户级或项目级已加载同内容规则/AGENTS.md 时跳过。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject-constraints.py"
            ],
            "name": "inject-constraints",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
