{
  "description": "会话启动注入约束全文；提示提交提醒并注入完整 DSH 时间块；工具事件注入一行时间；会话结束清理时间状态。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-constraints.js"
            ],
            "name": "inject-constraints",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-compact.js"
            ],
            "name": "inject-compact-constraints",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-constraints.js"
            ],
            "name": "inject-constraints-reminder",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-clock.js"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-clock.js"
            ],
            "name": "inject-clock-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-clock.js"
            ],
            "name": "inject-clock-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-clock.js"
            ],
            "name": "inject-clock-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-clock.js"
            ],
            "name": "cleanup-clock",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
