{
  "description": "会话启动注入用户全局约束；会话启动与每次提示提交注入当前本地时间。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_constraints.py"
            ],
            "name": "inject-constraints",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
