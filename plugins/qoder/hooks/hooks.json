{
  "description": "首次会话启动把全局用户约束安装到用户 rules；每次提示提交只提醒 Never violate global user constraints 并注入当前本地时间。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/install_constraints.py"
            ],
            "name": "install-constraints",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_constraints.py"
            ],
            "name": "inject-constraints-reminder",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
