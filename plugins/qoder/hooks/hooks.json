      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/install_constraints.py"
            ],
            "name": "install-constraints",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/trajectory.py"
            ],
            "name": "trajectory",
            "timeout": 10
          }
        ]
      }
    ],
