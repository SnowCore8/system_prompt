{
  "description": "首次会话启动安装全局用户约束到用户 rules；子代理未加载时全文兜底；每次提示提交提醒；会话启动与每次提示提交注入当前本地时间。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/install_constraints.py"
            ],
            "name": "install-constraints",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_constraints.py"
            ],
            "name": "inject-constraints",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_constraints.py"
            ],
            "name": "inject-constraints-subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_constraints.py"
            ],
            "name": "inject-constraints-reminder",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
