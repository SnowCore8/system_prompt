{
  "description": "首次会话启动安装用户 rules；提示提交提醒并注入完整 DSH 时间块；工具事件注入一行时间；会话结束清理时间状态。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/install_constraints.py"
            ],
            "name": "install-constraints",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_compact.py"
            ],
            "name": "inject-compact-constraints",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_constraints.py"
            ],
            "name": "inject-constraints-reminder",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "inject-clock-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-X",
              "utf8",
              "${QODER_PLUGIN_ROOT}/scripts/inject_clock.py"
            ],
            "name": "cleanup-clock",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
