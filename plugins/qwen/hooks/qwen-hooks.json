{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-clock.js\"",
          "name": "inject-clock",
          "description": "注入当前本地时间",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-clock.js\"",
          "name": "inject-clock",
          "description": "每次提示提交前刷新当前时间",
          "timeout": 10
        }
      ]
    }
  ]
}
