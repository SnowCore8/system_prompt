{
  "description": "Inject the current local time into hook events that support additionalContext.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/scripts/inject-time.py"
            ],
            "name": "inject-time",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
