{
  "name": "@snowcore8/se-dsh",
  "version": "1.0.0",
  "description": "se-governance DSH bundle：治理章程注入、二十四个覆盖软件工程全生命周期的 skill，以及 se-mcp 工具（经 cordis.patch.yml 挂载）。",
  "type": "module",
  "main": "plugins/dsh/src/index.js",
  "workspaces": [
    "mcp"
  ],
  "files": [
    "plugins/dsh/src",
    "plugins/dsh/cordis.patch.yml",
    "skills",
    "rules",
    "README.md",
    "LICENSE",
    "LICENSE-CC-BY-4.0.txt",
    "LICENSE-MIT.txt",
    "THIRD-PARTY-NOTICES.md",
    "mcp"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "check:js": "biome check .",
    "format:js": "biome check --write .",
    "bench:hooks": "node scripts/bench-hooks.mjs",
    "coverage:js": "c8 --check-coverage --lines 90 --branches 85 --functions 90 node --test \"tests/hooks/*.test.js\" \"tests/dsh/*.test.mjs\" \"tests/mcp/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "c8": "12.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugins/dsh/cordis.patch.yml"
    }
  },
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowCore8/system_prompt.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
